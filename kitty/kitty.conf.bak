#
# IMPORTANTE
# Para recargar la configuración basta con mandar la señal SIGUSR1,
# es decir presionar cmd + cmd + ',' 
#

hide_window_decorations titlebar-only
# window_padding_width  25 10 10
window_padding_width 5

font_family FiraCode Nerd Font Mono
#font_family Hack Nerd Font Mono
font_size 13

disable_ligatures never

url_style curly
cursor_shape beam
cursor_beam_thickness 1.8

mouse_hide_wait 3.0
detect_urls yes

repaint_delay 10
input_delay 3
sync_to_monitor yes



tab_bar_style       custom
tab_bar_edge top
tab_separator       ""
# tab_title_template  " {title} "
tab_title_template              "  {index}:{f'{title[:6]}…{title[-6:]}' if title.rindex(title[-1]) + 1 > 25 else title}{' []' if layout_name == 'stack' else ''} "
active_tab_title_template       "  {index}:{f'{title[:6]}…{title[-6:]}' if title.rindex(title[-1]) + 1 > 25 else title}{' []' if layout_name == 'stack' else ''} "
# tab_bar_min_tabs 1
# tab_bar_style powerline
# tab_powerline_style round
# tab_title_template "{fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.tab}{index}{'(%d)'%num_windows if num_windows > 1 else ''}: {(title.replace('nachh@Sentinel:', '')[:6]+'…'+title.replace('nachh@Sentinel:', '')[-6:]) if title.replace('nachh@Sentinel:', '').rindex(title.replace('nachh@Sentinel:', '')[-1]) + 1 > 13 else title.replace('nachh@Sentinel:', '')}"
#
# # inactive_tab_background #faf2d6
# inactive_tab_background #b2bfE9
# inactive_tab_foreground #000000
# tab_bar_margin_color black

background_opacity 0.95
bell_on_tab "🔔 "
enable_audio_bell yes 

shell zsh --login


# BEGIN_KITTY_THEME
# Catppuccin-Latte
include current-theme.conf
# END_KITTY_THEME
