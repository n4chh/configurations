{
	"palette": {
		"UbuntuOrange": "#E95420",
		"OrangeLight": "#F4AA61",
		"AubergineDeep": "#2C001E",
		"AubergineMid": "#77216F",
		"WarmGrey": "#AEA79F",
		"White": "#FFFFFF",
		"Black": "#000000",
		"Red": "#EF2929",
		"Error": "#CC0000"
	},
	"transient_prompt": {
		"template": "<p:UbuntuOrange>{{if .Root}}</><p:Red>{{end}}</><p:AubergineDeep,p:UbuntuOrange>{{if .Root}}</><p:White,p:Red>{{end}}<b>{{.Shell}}</b></><p:UbuntuOrange>{{if .Root}}</><p:Red>{{end}}</><p:OrangeLight>  </> {{ .PWD }} <p:UbuntuOrange>❱ ",
		"foreground": "default",
		"background": "transparent"
	},
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"properties": {
						"cache_duration": "none",
						"style": "full",
						"folder_icon": " ",
						"mapped_locations_enabled": true,
						"mapped_locations": {
							"~/Desktop/Github": "  ",
							"~/.config": "  "
						}
					},
					"powerline_symbol": "",
					"template": "<b> {{ .Path }} </b>",
					"foreground": "default",
					"background": "transparent",
					"type": "path",
					"style": "powerline"
				},
				{
					"properties": {
						"branch_icon": " ",
						"cache_duration": "none",
						"display_changing_color": true,
						"fetch_status": true,
						"fetch_upstream_icon": true,
						"full_branch_path": true
					},
					"template": "  ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#8AE234> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#EF2929> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }}<p:White>  {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<p:AubergineDeep>  {{ .Staging.String }}</>{{ end }} ",
					"foreground": "p:AubergineDeep",
					"background": "p:UbuntuOrange",
					"type": "git",
					"powerline_symbol": "",
					"style": "powerline"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "right",
			"foreground": "transparent",
			"segments": [
				{
					"template": "  {{ .Full }}",
					"foreground": "p:Black",
					"background": "#50fa7b",
					"type": "node",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline"
				},
				{
					"template": "  {{ .Full }}",
					"foreground": "p:Black",
					"background": "#ff5555",
					"type": "npm",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline",
					"properties": {
						"display_mode": "files",
						"extensions": [
							"package-lock.json"
						]
					}
				},
				{
					"template": "󰋁 {{ .Full }}",
					"foreground": "p:Black",
					"background": "#ffb86c",
					"type": "pnpm",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline",
					"properties": {
						"display_mode": "files",
						"extensions": [
							"pnpm-lock.yaml"
						]
					}
				},
				{
					"template": "<#FEE058>󰌠 </>{{ .Full }}",
					"foreground": "p:White",
					"background": "#3870A2",
					"type": "python",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline",
					"properties": {
						"display_mode": "files"
					}
				},
				{
					"template": " 󰟓  {{ .Full }}",
					"foreground": "p:Black",
					"background": "#69d7e2",
					"type": "go",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline"
				},
				{
					"template": "<p:UbuntuOrange> </>{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
					"foreground": "p:AubergineDeep",
					"background": "p:OrangeLight",
					"type": "zig",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline"
				},
				{
					"template": "  {{ .Full }}",
					"foreground": "p:White",
					"background": "#6272a4",
					"type": "php",
					"powerline_symbol": "",
					"leading_powerline_symbol": "",
					"style": "powerline"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"leading_diamond": " ",
					"trailing_diamond": "",
					"template": "<p:OrangeLight>{{.Icon}}</> <b>{{base .Env.SHELL}}</b> ",
					"background": "p:AubergineMid",
					"foreground": "p:White",
					"type": "os",
					"style": "diamond",
					"properties": {
						"mapped_shell_names": {
							"pwsh": "PS"
						}
					}
				},
				{
					"powerline_symbol": "",
					"template": " {{ if .Root }}   {{end}}<b>{{ .UserName }}</b>{{if .SSHSession}}@<b>{{ .HostName }}</b>{{end}} ",
					"foreground": "p:White",
					"background": "p:UbuntuOrange",
					"background_templates": [
						"{{if .Root}}p:Red{{end}}"
					],
					"type": "session",
					"style": "powerline"
				},
				{
					"trailing_diamond": "",
					"leading_diamond": "<transparent,background></>",
					"template": " {{ if .Error}} {{.Code}}{{else}} {{end}}",
					"foreground": "p:White",
					"background": "p:WarmGrey",
					"background_templates": [
						"{{if .Error}}p:Error{{end}}"
					],
					"foreground_templates": [
						"{{if .Error}}p:White{{end}}"
					],
					"type": "status",
					"style": "diamond",
					"properties": {
						"always_enabled": true
					}
				}
			],
			"newline": true
		}
	],
	"version": 3,
	"patch_pwsh_bleed": true,
	"final_space": true
}
