{
	"transient_prompt": {
		"template": " <#3396D3></><#000000,#3396D3><b>{{.Shell}}</b> </><#3396D3,#FFF0CE> </><#000000,#FFF0CE>{{ .PWD }}</><#FFF0CE,default></> <b>></b> ",
		"foreground": "default",
		"background": "transparent"
	},
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"properties": {
						"cache_duration": "none"
					},
					"trailing_diamond": "",
					"leading_diamond": "",
					"template": "{{ .UserName }}@<b>{{ .HostName }}</b>",
					"foreground": "#000000",
					"background": "#EBCB90",
					"type": "session",
					"style": "diamond"
				},
				{
					"properties": {
						"cache_duration": "none",
						"style": "full",
						"folder_icon": " ",
						"style": "full",
						"mapped_locations_enabled": true,
						"mapped_locations": {
							"~/Desktop/Github": " ",
                            "~/.config": " "
						}
					},
					"powerline_symbol": "",
					"template": "<b> {{ .Path }} </b>",
					"foreground": "#000000",
					"background": "#FFF0CE",
					"type": "path",
					"style": "powerline"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "right",
			"segments": [
        {
          "properties": {
            "branch_icon": "",
            "cache_duration": "none",
            "display_changing_color": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "full_branch_path": true
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#50fa7b> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#ff5555> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }}<#ffffff>  {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<#000000>  {{ .Staging.String }}</>{{ end }}",
          "foreground": "#000000",
          "background": "#ffb86c",
          "type": "git",
          "style": "diamond"
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "#000000",
          "background": "#50fa7b",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "display_mode": "files",
            "extensions": [
              "package-lock.json"
            ]
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "#000000",
          "background": "#ff5555",
          "type": "npm",
          "style": "diamond"
        },
        {
          "properties": {
            "display_mode": "files",
            "extensions": [
              "pnpm-lock.yaml"
            ]
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "󰋁 {{ .Full }}",
          "foreground": "#000000",
          "background": "#ffb86c",
          "type": "pnpm",
          "style": "diamond"
        },
        {
          "properties": {
            "display_mode": "files"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "<#FEE058>󰌠 </>{{ .Full }}",
          "foreground": "#ffffff",
          "background": "#3870A2",
          "type": "python",
          "style": "diamond"
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "#ED1D23",
          "background": "#ffffff",
          "type": "java",
          "style": "diamond"
        },
        {
        	"template": " 󰟓 {{ .Full }}",
        	"foreground": "#000000",
        	"background": "#69d7e2",
        	"type": "go",
			"leading_diamond": "",
			"trailing_diamond": "",
        	"style": "diamond"
        },

		{
			"type": "zig",
			"style": "diamond",
			"leading_diamond": "",
			"trailing_diamond": "",
			"foreground": "#342311",
			"background": "#ffad55",
			"template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
		},
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "#ffffff",
          "background": "#6272a4",
          "type": "php",
          "style": "diamond"
        }
      ]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"trailing_diamond": "\ue0b4 ",
					"leading_diamond": " \ue0b6",
					"template": "<b>{{.Name}}</b>",
					"foreground": "#000000",
					"background": "#3396D3",
					"type": "shell",
					"style": "diamond"
				},
								{
					"template": "<b>></b>",
					"foreground": "default",
					"type": "text",
					"style": "plain"
				}

			],
			"newline": true
		}
	],
	"version": 3,
	"patch_pwsh_bleed": true,
	"final_space": true
}
