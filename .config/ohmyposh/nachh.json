{
	"transient_prompt": {
		"template": "[{{.Shell}}]:{{ .AbsolutePWD }}:> ",
		"foreground": "default",
		"background": "transparent"
	},
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"properties": {
						"always_enabled": true,
						"cache_duration": "none"
					},
					"trailing_diamond": "\ue0b0",
					"leading_diamond": "\ue0b6",
					"template": "[{{.Name}}]",
					"foreground": "default",
					"type": "shell",
					"style": "plain"
				},
				{
					"properties": {
						"cache_duration": "none"
					},
					"trailing_diamond": "\ue0b0",
					"leading_diamond": "\ue0b6",
					"template": "[{{ .UserName }}@<b>{{ .HostName }}</b>]",
					"foreground": "default",
					"type": "session",
					"style": "plain"
				},
				{
					"properties": {
						"cache_duration": "none",
						"style": "full",
						"folder_icon": " ",
						"style": "full",
						"mapped_locations_enabled": true,
						"mapped_locations": {
							"~/Desktop/Github": " ",
                            "~/.config": " "
						}
					},
					"powerline_symbol": ":",
					"template": "<b>{{ .Path }}</b>",
					"foreground": "default",
					"type": "path",
					"style": "powerline"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "right",
			"segments": [
				{
					"properties": {
						"branch_icon": "",
						"cache_duration": "none",
						"display_changing_color": true,
						"fetch_status": true,
						"fetch_upstream_icon": true,
						"full_branch_path": true
					},
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "[\ue725 ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#50fa7b> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#ff5555> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}</>{{ end }}]",
					"foreground": "default",
					"type": "git",
					"style": "plain"
				},
				{
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "\ue718 {{ .Full }}",
					"foreground": "#282a36",
					"background": "#50fa7b",
					"type": "node",
					"style": "diamond"
				},
				{
					"properties": {
						"display_mode": "files",
						"extensions": [
							"package-lock.json"
						]
					},
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "\ue71e {{ .Full }}",
					"foreground": "#282a36",
					"background": "#ff5555",
					"type": "npm",
					"style": "diamond"
				},
				{
					"properties": {
						"display_mode": "files",
						"extensions": [
							"pnpm-lock.yaml"
						]
					},
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "\udb80\udec1 {{ .Full }}",
					"foreground": "#282a36",
					"background": "#ffb86c",
					"type": "pnpm",
					"style": "diamond"
				},
				{
					"properties": {
						"display_mode": "files"
					},
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "\ue73c {{ .Full }}",
					"foreground": "#282a36",
					"background": "#50fa7b",
					"type": "python",
					"style": "diamond"
				},
				{
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "\ue738 {{ .Full }}",
					"foreground": "#282a36",
					"background": "#ff79c6",
					"type": "java",
					"style": "diamond"
				},
				{
					"leading_diamond": "\ue0b6",
					"trailing_diamond": "\ue0b4",
					"template": "\ue73d {{ .Full }}",
					"foreground": "#f8f8f2",
					"background": "#6272a4",
					"type": "php",
					"style": "diamond"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"template": ">",
					"foreground": "default",
					"type": "text",
					"style": "plain"
				}
			],
			"newline": true
		}
	],
	"version": 3,
	"patch_pwsh_bleed": true,
	"final_space": true
}
