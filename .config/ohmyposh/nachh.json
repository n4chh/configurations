{
	"palette": {
		"Black": "#000000",
		"White": "#FFFFFF"
	},
	"palettes": {
		"template": "{{ if eq .Env.THEME \"Dark\" }}mocha{{ else }}latte{{ end }}",
		"list": {
			"latte": {
				"Rosewater": "#dc8a78",
				"Flamingo": "#dd7878",
				"Pink": "#ea76cb",
				"Mauve": "#8839ef",
				"Red": "#d20f39",
				"Maroon": "#e64553",
				"Peach": "#fe640b",
				"Yellow": "#df8e1d",
				"Green": "#40a02b",
				"Teal": "#179299",
				"Sky": "#04a5e5",
				"Sapphire": "#209fb5",
				"Blue": "#1e66f5",
				"Lavender": "#7287fd",
				"Text": "#4c4f69",
				"Subtext1": "#5c5f77",
				"Subtext0": "#6c6f85",
				"Overlay2": "#7c7f93",
				"Overlay1": "#8c8fa1",
				"Overlay0": "#9ca0b0",
				"Surface2": "#acb0be",
				"Surface1": "#bcc0cc",
				"Surface0": "#ccd0da",
				"Base": "#eff1f5",
				"Mantle": "#e6e9ef",
				"Crust": "#dce0e8"
			},

			"mocha": {
				"Rosewater": "#f5e0dc",
				"Flamingo": "#f2cdcd",
				"Pink": "#f5c2e7",
				"Mauve": "#cba6f7",
				"Red": "#f38ba8",
				"Maroon": "#eba0ac",
				"Peach": "#fab387",
				"Yellow": "#f9e2af",
				"Green": "#a6e3a1",
				"Teal": "#94e2d5",
				"Sky": "#89dceb",
				"Sapphire": "#74c7ec",
				"Blue": "#89b4fa",
				"Lavender": "#b4befe",
				"Text": "#cdd6f4",
				"Subtext1": "#bac2de",
				"Subtext0": "#a6adc8",
				"Overlay2": "#9399b2",
				"Overlay1": "#7f849c",
				"Overlay0": "#6c7086",
				"Surface2": "#585b70",
				"Surface1": "#45475a",
				"Surface0": "#313244",
				"Base": "#1e1e2e",
				"Mantle": "#181825",
				"Crust": "#11111b"
			}
		}
	},

	"transient_prompt": {
		"template": "{{.Env.HOLA}} <p:Mauve>[</>{{if .Root}}<p:Red>{{end}}<b>{{.Segments.Shell.Name}}</b></><p:Mauve>]</> <p:Sky>{{ .PWD }}</> <b>></b> ",
		"foreground": "default",
		"background": "transparent"
	},

	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"properties": {
						"cache_duration": "none"
					},
					"template": "{{ if .Root }}<b>{{end}}{{ .UserName }}{{ if .Root}}</b>{{end}}{{if .SSHSession}}@<b>{{ .HostName }}</b>{{end}}",
					"foreground": "p:Black",
					"background": "transparent",
					"foreground_templates": [
						"{{if .Root}}p:Red{{end}}"
					],
					"type": "session",
					"style": "plain"
				},
				{
					"properties": {
						"cache_duration": "none",
						"style": "full",
						"folder_icon": " ",
						"style": "full",
						"mapped_locations_enabled": true,
						"mapped_locations": {
							"~/Desktop/Github": " ",
                            "~/.config": " "
						}
					},
					"powerline_symbol": "",
					"template": "<b> {{ .Path }} </b>",
					"foreground": "p:Sky",
					"background": "transparent",
					"type": "path",
					"style": "powerline"
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "right",
			"segments": [
        {
          "properties": {
            "branch_icon": "",
            "cache_duration": "none",
            "display_changing_color": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "full_branch_path": true
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " ({{ url .UpstreamIcon .UpstreamURL }} {{ url .HEAD .UpstreamURL }}){{ if gt .Ahead 0 }}<#50fa7b> +{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<#ff5555> -{{ .Behind }}</>{{ end }}{{ if .Working.Changed }}<p:White>  {{ .Working.String }}</>{{ end }}{{ if .Staging.Changed }}<p:Black>  {{ .Staging.String }}</>{{ end }}",
          "foreground": "p:Black",
          "background": "#ffb86c",
          "type": "git",
          "style": "diamond"
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "p:Black",
          "background": "#50fa7b",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "display_mode": "files",
            "extensions": [
              "package-lock.json"
            ]
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "p:Black",
          "background": "#ff5555",
          "type": "npm",
          "style": "diamond"
        },
        {
          "properties": {
            "display_mode": "files",
            "extensions": [
              "pnpm-lock.yaml"
            ]
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "󰋁 {{ .Full }}",
          "foreground": "p:Black",
          "background": "#ffb86c",
          "type": "pnpm",
          "style": "diamond"
        },
        {
          "properties": {
            "display_mode": "files"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": "<#FEE058>󰌠 </>{{ .Full }}",
          "foreground": "p:White",
          "background": "#3870A2",
          "type": "python",
          "style": "diamond"
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "#ED1D23",
          "background": "p:White",
          "type": "java",
          "style": "diamond"
        },
        {
        	"template": " 󰟓 {{ .Full }}",
        	"foreground": "p:Black",
        	"background": "#69d7e2",
        	"type": "go",
			"leading_diamond": "",
			"trailing_diamond": "",
        	"style": "diamond"
        },

		{
			"type": "zig",
			"style": "diamond",
			"leading_diamond": "",
			"trailing_diamond": "",
			"foreground": "#342311",
			"background": "#ffad55",
			"template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
		},
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .Full }}",
          "foreground": "p:White",
          "background": "#6272a4",
          "type": "php",
          "style": "diamond"
        }
      ]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"leading_diamond": " ",
					"trailing_diamond": " ",
					"template": " <b>{{.Name}}</b> ",
					"background": "transparent",
					"foreground": "p:Mauve",
					"type": "shell",
					"style": "diamond",
					"properties": {
						"mapped_shell_names": {
							"pwsh": "PS"
						}
					}
				},
								{
					"template": "<b>></b>",
					"foreground": "default",
					"type": "text",
					"style": "plain"
				}

			],
			"newline": true
		}
	],
	"version": 3,
	"patch_pwsh_bleed": true,
	"final_space": true
}
